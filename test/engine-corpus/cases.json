  {
    "id": "fixed-write-apply-pass",
    "endpoint": "fixed-script",
    "description": "Scripted apply_step result preserves property/exists/wire checks",
    "fixedScript": {
      "call": {
        "id": "write-apply-1",
        "name": "apply_step",
        "arguments": {
          "summary": "Add and connect a debug node",
          "newNodes": [
            {
              "id": "fp-new-0",
              "type": "debug",
              "name": "Output"
            }
          ],
          "newWires": [
            {
              "from": "n1",
              "fromPort": 0,
              "to": "fp-new-0"
            }
          ]
        }
      },
      "result": {
        "summary": "Add and connect a debug node",
        "checks": [
          {
            "nodeId": "fp-new-0",
            "check": "exists",
            "expected": true,
            "actual": true,
            "pass": true
          },
          {
            "nodeId": "fp-new-0",
            "check": "property",
            "prop": "name",
            "expected": "Output",
            "actual": "Output",
            "pass": true
          },
          {
            "fromId": "n1",
            "fromPort": 0,
            "toId": "fp-new-0",
            "check": "wire",
            "expected": true,
            "actual": true,
            "pass": true
          }
        ]
      }
    },
    "expect": "fixed_script_success"
  },
  {
